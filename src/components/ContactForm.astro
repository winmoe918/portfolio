---
import { links } from "../data/site";
import Icon from "./Icon.astro";
import SectionTitle from "./SectionTitle.astro";

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
---

<section id="contact" class="section">
  <p class="label" data-reveal="fade-right" data-intensity="0">Contact</p>
  <SectionTitle>Let's work <span class="grad">together.</span></SectionTitle>
  <p data-reveal="fade-up" data-intensity="2">
    Want a Workify demo for your fleet, need an engineer for an AI or data project, or hiring? Send me a note and I'll
    get back to you within a day.
  </p>

  <form class="card form" data-contact-form data-key={accessKey} data-email={links.email} novalidate data-reveal="fade-up">
    <div class="row">
      <label>
        <span>Name</span>
        <input name="name" type="text" autocomplete="name" required />
      </label>
      <label>
        <span>Email</span>
        <input name="email" type="email" autocomplete="email" required />
      </label>
    </div>
    <label>
      <span>Company <em>(optional)</em></span>
      <input name="company" type="text" autocomplete="organization" />
    </label>
    <label>
      <span>Message</span>
      <textarea name="message" rows="5" required></textarea>
    </label>
    <!-- Honeypot for bots (Web3Forms) -->
    <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="form-foot">
      <button class="btn btn-primary" type="submit">Send message <Icon name="arrow" /></button>
      <p class="status" role="status" aria-live="polite"></p>
    </div>
  </form>

</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    const status = form.querySelector<HTMLElement>(".status")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const setStatus = (text: string, tone: "ok" | "error" | "") => {
      status.textContent = text;
      status.dataset.tone = tone;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get("name") ?? "").trim();
      const email = String(data.get("email") ?? "").trim();
      const message = String(data.get("message") ?? "").trim();
      const company = String(data.get("company") ?? "").trim();

      form.querySelectorAll("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"));
      const invalid: string[] = [];
      if (!name) invalid.push("name");
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) invalid.push("email");
      if (!message) invalid.push("message");
      if (invalid.length) {
        invalid.forEach((n) => form.elements.namedItem(n) && (form.elements.namedItem(n) as HTMLElement).setAttribute("aria-invalid", "true"));
        (form.elements.namedItem(invalid[0]) as HTMLElement).focus();
        setStatus("Please fill in your name, a valid email and a message.", "error");
        return;
      }

      const key = form.dataset.key;
      if (!key) {
        // No form service configured: hand off to the visitor's mail app
        const subject = encodeURIComponent(`Hello from ${name}${company ? ` (${company})` : ""}`);
        const body = encodeURIComponent(`${message}\n\n${name}\n${email}`);
        window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
        setStatus("Opening your email app…", "ok");
        return;
      }

      button.disabled = true;
      setStatus("Sending…", "");
      try {
        data.append("access_key", key);
        data.append("subject", `Portfolio message from ${name}${company ? ` (${company})` : ""}`);
        data.append("from_name", "Portfolio Contact Form");
        const res = await fetch("https://api.web3forms.com/submit", { method: "POST", body: data });
        const json = await res.json();
        if (!res.ok || !json.success) throw new Error(json.message || "Request failed");
        form.reset();
        setStatus("Thanks! Your message is on its way. I'll reply soon.", "ok");
      } catch {
        setStatus(`Something went wrong. Please email me at ${form.dataset.email}.`, "error");
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
    padding: 2rem;
    border-radius: 2rem;
    text-align: left;
  }
  .form:hover {
    background: var(--surface);
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.8em;
  }
  label em {
    color: var(--faint);
    font-style: normal;
  }
  input,
  textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 0;
    border-radius: 0.875rem;
    background: rgba(0, 0, 0, 0.25);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--text);
    font: inherit;
    font-size: 1.1em;
    transition: box-shadow 0.25s ease;
  }
  textarea {
    resize: vertical;
    min-height: 8rem;
  }
  input:focus,
  textarea:focus {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--accent);
  }
  [aria-invalid="true"] {
    box-shadow: inset 0 0 0 2px #f87171;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .form-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .btn:disabled {
    opacity: 0.6;
    cursor: progress;
    transform: none;
  }
  .status {
    font-size: 0.8em;
    color: var(--muted);
  }
  .status[data-tone="ok"] {
    color: var(--accent);
  }
  .status[data-tone="error"] {
    color: #f87171;
  }
  @media (max-width: 736px) {
    .form {
      padding: 1.5rem;
    }
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
