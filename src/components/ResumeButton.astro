---
// Floating "View my résumé" button, fixed to the bottom-right corner.
// Shows only an icon; expands to show its label on hover/focus, and "peeks"
// (opens briefly by itself) shortly after load to invite a click.
import { links } from "../data/site";
import LineIcon from "./LineIcon.astro";
---

<a class="resume-fab" href={links.resume} aria-label="View my résumé" data-resume-fab>
  <span class="fab-icon"><LineIcon name="page" /></span>
  <span class="fab-label" aria-hidden="true">View my résumé <LineIcon name="arrow" class="fab-arrow" /></span>
</a>

<script>
  const fab = document.querySelector<HTMLElement>("[data-resume-fab]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (fab && !reduce) {
    // Slide in once the page has faded in, then peek the label open for a moment
    setTimeout(() => fab.classList.add("is-in"), 900);
    setTimeout(() => fab.classList.add("is-peek"), 2200);
    setTimeout(() => fab.classList.remove("is-peek"), 5200);
  } else {
    fab?.classList.add("is-in");
  }
</script>

<style>
  .resume-fab {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 40;
    display: flex;
    align-items: center;
    height: 3.5rem;
    padding: 0 0.5rem 0 0;
    border-radius: 999px;
    background: #ffffff;
    color: var(--btn-text);
    font-family: var(--font-body);
    font-size: 0.85rem;
    white-space: nowrap;
    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.08);
    opacity: 0;
    transform: translateY(1.5rem);
    transition:
      opacity 1s ease,
      transform 1s ease,
      box-shadow 0.375s ease;
  }
  .resume-fab:global(.is-in) {
    opacity: 1;
    transform: none;
  }

  /* Soft green ring that pulses outward, like a "tap here" cue */
  .resume-fab::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.55);
    animation: fab-pulse 3.2s ease-out 2.5s infinite;
  }
  @keyframes fab-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.55);
    }
    70%,
    100% {
      box-shadow: 0 0 0 16px rgba(34, 197, 94, 0);
    }
  }

  .fab-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-right: -0.5rem;
  }
  .fab-icon :global(.line-icon) {
    width: 1.45rem;
    height: 1.45rem;
    transition: transform 0.45s ease;
  }

  /* Label is collapsed to zero width; it slides open on hover/focus/peek */
  .fab-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-width 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease,
      padding 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .fab-label :global(.fab-arrow) {
    width: 1.05rem;
    height: 1.05rem;
    transition: transform 0.375s ease;
  }

  .resume-fab:hover,
  .resume-fab:focus-visible,
  .resume-fab:global(.is-peek) {
    box-shadow:
      0 14px 36px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(34, 197, 94, 0.35),
      0 0 26px rgba(34, 197, 94, 0.25);
  }
  .resume-fab:hover .fab-label,
  .resume-fab:focus-visible .fab-label,
  .resume-fab:global(.is-peek) .fab-label {
    max-width: 12rem;
    opacity: 1;
    padding: 0 0.85rem 0 0.25rem;
  }
  .resume-fab:hover .fab-icon :global(.line-icon),
  .resume-fab:focus-visible .fab-icon :global(.line-icon) {
    transform: rotate(-8deg) scale(1.08);
  }
  .resume-fab:hover .fab-label :global(.fab-arrow) {
    transform: translateX(3px);
  }

  @media (max-width: 736px) {
    .resume-fab {
      right: 1rem;
      bottom: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .resume-fab {
      opacity: 1;
      transform: none;
    }
    .resume-fab::before {
      animation: none;
    }
  }
</style>
