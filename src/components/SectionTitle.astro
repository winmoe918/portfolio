---
// Section heading with the decorative line-circle-sparkle icon at the right end
// (icon after pavlobondarenko.net/images/icon.svg)
---

<div class="title-row">
  <h2 data-reveal="fade-up" data-split="words" data-stagger="125"><slot /></h2>
  <svg class="title-icon" viewBox="0 0 46 42" fill="none" aria-hidden="true" data-reveal="fade-left">
    <path
      d="M30.9224 21.2014C25.1291 21.2014 24.618 24.7796 24.618 27.3354C24.618 21.5421 21.5509 21.2014 17.9727 21.2014C24.618 21.2014 24.618 17.2824 24.618 14.8969C24.618 20.3494 27.8554 21.2014 30.9224 21.2014Z"
      fill="currentColor"
      stroke="currentColor"></path>
    <rect y="21.6981" width="1" height="18" transform="rotate(-90 0 21.6981)" fill="currentColor"></rect>
    <path
      d="M9.93715 16.8555C10.9514 13.0701 13.2829 9.77074 16.5123 7.55063C19.7417 5.33052 23.6571 4.33531 27.5547 4.74394C31.4522 5.15258 35.0762 6.93825 37.7749 9.77989C40.4736 12.6215 42.07 16.3327 42.2771 20.2461C42.4842 24.1596 41.2884 28.0185 38.9047 31.1291C36.5211 34.2398 33.1059 36.398 29.2732 37.2157C25.4406 38.0335 21.4419 37.4571 17.9962 35.5903C14.5505 33.7234 11.8839 30.6886 10.4757 27.0314"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  </svg>
</div>

<style>
  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .title-icon {
    flex-shrink: 0;
    width: 3rem;
    height: auto;
    color: #f4f4f4;
    opacity: 0.85;
  }
  /* Gradient phrase at the end of each title, e.g. "together." */
  .title-row :global(.grad) {
    /* Extend the painted box below the baseline so descenders (g, y) aren't clipped */
    padding-bottom: 0.15em;
    margin-bottom: -0.15em;
    background: linear-gradient(90deg, #ff4f8b 0%, #ff9ec0 30%, #b58cff 62%, #3d6bff 88%, #2f5bff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  @media (max-width: 736px) {
    .title-row {
      justify-content: center;
      gap: 0.9rem;
    }
    .title-icon {
      width: 2.25rem;
    }
  }
</style>
